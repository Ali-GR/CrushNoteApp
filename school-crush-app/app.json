{
  "expo": {
    "name": "Crush Note",
    "slug": "school-crush-app",
    "version": "1.0.0",
    "scheme": "school-crush-app",
    "orientation": "portrait",
    "icon": "./assets/logo.jpeg",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#0C0C1C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crushnote.ios",
      "buildNumber": "2",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.crushnote.ios",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.jpeg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2229065647862844~1547218328",
          "iosAppId": "ca-app-pub-2229065647862844~7677512401",
          "userTrackingUsageDescription": "Diese App verwendet Tracking-Daten, um dir personalisierte und relevante Werbung anzuzeigen."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Diese App verwendet Tracking-Daten, um dir personalisierte Werbung anzuzeigen."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3677b5b7-4bcb-4a4b-8b8a-4736a249be80"
      }
    },
    "owner": "algobanyali"
  }
}
